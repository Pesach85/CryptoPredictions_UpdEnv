# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Virtual environment
.venv/
venv/
env/

# IDE
.idea/
.vscode/settings.json

# Hydra outputs (generated runtime artifacts — not committed)
outputs/

# Backup files
*_backup.*
*.bak
*.bak_*

# Environment / secrets — never commit credentials
.env
.env.*
*.secret
*.pem
*.key

# OS
Thumbs.db
.DS_Store

# Packaging / editable install metadata
*.egg-info/
cryptopredictions.egg-info/

# Packaging / Android build artifacts
packaging/android/**/build/
packaging/android/**/.gradle/
packaging/android/**/local.properties
packaging/android/**/*.apk
packaging/android/**/*.aab
*.iml

# Generated local install state (never commit)
# (config lives under user AppData / XDG — not in repo)
